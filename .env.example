# Copie este arquivo para .env e preencha os valores.
# O .env real é ignorado pelo git (contém segredos) — nunca commite.

# Banco de dados (Prisma + SQLite, dev local)
DATABASE_URL="file:./dev.db"

# Chave para criptografia em repouso dos campos sensíveis
# (RegistroHumor.nota, EntradaDiario.conteudo, MensagemChat.conteudo).
# Gere uma chave forte, ex.: openssl rand -base64 32
ENCRYPTION_KEY=""
